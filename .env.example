# PostgreSQL connection strings
DATABASE_URL="postgresql://user:password@localhost:5432/kassmart?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/kassmart?schema=public"

# Session signing secret (WAJIB diisi minimal 32 karakter acak di production)
# Contoh generate: openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-32-character-random-secret"

# Opsional: paksa atribut Secure pada cookie sesi bila aplikasi berada di belakang HTTPS
# COOKIE_SECURE="true"
